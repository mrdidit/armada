+static int qcom_battmgr_set_charge_rate_behaviour(struct qcom_battmgr *battmgr,
+					       int behaviour)
+{
+	struct qcom_battmgr_charge_rate_request request = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(BATTMGR_SET_CHARGE_RATE),
+		.battery_id = cpu_to_le32(0),
+		.charging_path = cpu_to_le32(0),
+	};
+	u32 epoch;
+	int ret;
+
+	if (!battmgr->charge_rate_supported)
+		return -EOPNOTSUPP;
+	if (behaviour != POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO &&
+	    behaviour != POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE)
+		return -EINVAL;
+
+	request.charge_rate = cpu_to_le32(behaviour ==
+		POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO ? 100 : 0);
+	mutex_lock(&battmgr->lock);
+	epoch = READ_ONCE(battmgr->service_epoch);
+	if (!READ_ONCE(battmgr->service_up)) {
+		ret = -EAGAIN;
+		goto out;
+	}
+	/* The diagnostic must not mix this command with native percentage limiting. */
+	if (behaviour == POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE) {
+		battmgr->native_charge_limit_valid = false;
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET,
+						    BATT_CHG_CTRL_EN, 0);
+		if (ret)
+			goto out;
+		if (!battmgr->native_charge_limit_valid) {
+			ret = -EPROTO;
+			goto out;
+		}
+		if (battmgr->native_charge_limit_enabled) {
+			ret = -EBUSY;
+			goto out;
+		}
+	}
+	if (epoch != READ_ONCE(battmgr->service_epoch) ||
+	    !READ_ONCE(battmgr->service_up)) {
+		ret = -EAGAIN;
+		goto out;
+	}
+	/* A failed or interrupted request leaves the effective state unknown. */
+	battmgr->charge_rate_known = false;
+	ret = qcom_battmgr_request(battmgr, &request, sizeof(request));
+	if (!ret && (epoch != READ_ONCE(battmgr->service_epoch) ||
+		     !READ_ONCE(battmgr->service_up)))
+		ret = -EAGAIN;
+	if (!ret) {
+		battmgr->charge_rate_inhibited =
+			behaviour == POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE;
+		battmgr->charge_rate_epoch = epoch;
+		battmgr->charge_rate_known = true;
+	}
+out:
+	mutex_unlock(&battmgr->lock);
+	if (!ret)
+		power_supply_changed(battmgr->bat_psy);
+	return ret > 0 ? -EIO : ret;
+}
