+{
+	struct power_supply_desc *desc;
+	enum power_supply_property *props;
+
+	desc = devm_kmemdup(battmgr->dev, base, sizeof(*base), GFP_KERNEL);
+	if (!desc)
+		return ERR_PTR(-ENOMEM);
+	props = devm_kcalloc(battmgr->dev, base->num_properties + 1,
+			     sizeof(*props), GFP_KERNEL);
+	if (!props)
+		return ERR_PTR(-ENOMEM);
+	memcpy(props, base->properties, base->num_properties * sizeof(*props));
+	props[base->num_properties] = POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR;
+	desc->properties = props;
+	desc->num_properties++;
+	desc->charge_behaviours = BIT(POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO) |
+		BIT(POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE);
+	return desc;
