+	was_offline = was_valid && !battmgr->kpfe_usb_online;
+	pending_rearm = battmgr->kpfe_rearm_state != KPFE_REARM_IDLE &&
+		battmgr->kpfe_rearm_service_gen == service_gen;
+	if (pending_rearm &&
+	    (battmgr->kpfe_rearm_state == KPFE_REARM_DISABLE_ONLY ||
+	     battmgr->kpfe_rearm_state == KPFE_REARM_RECONCILE)) {
+		qcom_battmgr_kpfe_queue_rearm_locked(battmgr, 0);
+		goto out_unlock;
+	}
+
+	ret = qcom_battmgr_kpfe_update_usb_online(battmgr);
+	if (ret) {
+		if (battmgr->kpfe_charge_behaviour ==
