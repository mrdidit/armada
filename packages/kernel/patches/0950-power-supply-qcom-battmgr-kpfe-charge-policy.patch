From: mrdidit <26687854+mrdidit@users.noreply.github.com>
Subject: [PATCH] power: supply: qcom_battmgr: isolate KPFE charge policy behind device match

Extract the battery property-29 command, precise device scoping and
fail-safe attach/restart re-arm lifecycle from the ROCKNIX
0518/0520/0522 changes. Keep USB supplies read-only; no PPS, input-
current or external-pump controls.

Select KPFE-only request, reply, threshold and lifecycle paths through
immutable exact-root and PMIC-GLINK match data. Preserve the existing
paths on every unmatched device. On KPFE, correlate the
available opcode/property fields, reject malformed replies and
preserve transport errors. The firmware's property-29 SET ACK does not
define value or result; untagged same-property late replies still
require a bounded quiet drain. Keep requested charge_behaviour
separate from observed telemetry.

Return KPFE threshold RPC errors and serialize their cache updates.
Preserve Armada's existing charge-unit and charge-now changes.

Derived from mrdidit/distribution
cda2efe728dca5c788851c79bfde121190bfd3ed: 0518, scoping only from
0520, and 0522. Original author: mrdidit. The target driver remains
GPL-2.0-only with its original copyright notices. Prepared against
Armada 6027251e6c087d18433f0d1b0731b514ff217a25 (7.2.3). This is a
review candidate, not evidence of Armada hardware validation.

---
diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -9,6 +9,8 @@
 #include <linux/mutex.h>
 #include <linux/nvmem-consumer.h>
 #include <linux/of_device.h>
+#include <linux/jiffies.h>
+#include <linux/of.h>
 #include <linux/power_supply.h>
 #include <linux/property.h>
 #include <linux/soc/qcom/pdr.h>
@@ -26,6 +28,13 @@
 	QCOM_BATTMGR_X1E80100,
 };
 
+enum qcom_battmgr_kpfe_rearm_state {
+	KPFE_REARM_IDLE,
+	KPFE_REARM_PREPARE,
+	KPFE_REARM_DISABLE_ONLY,
+	KPFE_REARM_RECONCILE,
+};
+
 #define BATTMGR_BAT_STATUS		0x1
 
 #define BATTMGR_REQUEST_NOTIFICATION	0x4
@@ -74,6 +83,8 @@
 #define BATT_CHG_CTRL_START_THR		25
 #define BATT_CHG_CTRL_END_THR		26
 
+#define BATT_ONLINE			29
+
 #define BATTMGR_USB_PROPERTY_GET	0x32
 #define BATTMGR_USB_PROPERTY_SET	0x33
 #define USB_ONLINE			0
@@ -87,6 +98,13 @@
 #define USB_MOISTURE_DET_EN		8
 #define USB_MOISTURE_DET_STS		9
 
+#define KPFE_BYPASS_REARM_DELAY_MS	2000
+#define KPFE_BYPASS_RETRY_MS		250
+#define KPFE_BYPASS_RETRY_TIMEOUT_MS	5000
+#define KPFE_BYPASS_SLOW_RETRY_MS	5000
+#define KPFE_BYPASS_ACK_DRAIN_MS	1000
+#define KPFE_BYPASS_ACK_DRAIN_MAX	2
+
 #define BATTMGR_WLS_PROPERTY_GET	0x34
 #define BATTMGR_WLS_PROPERTY_SET	0x35
 #define WLS_ONLINE			0
@@ -248,6 +266,7 @@
 	bool valid;
 
 	bool present;
+	bool online;
 	unsigned int charge_type;
 	unsigned int design_capacity;
 	unsigned int last_full_capacity;
@@ -307,11 +326,18 @@
 	unsigned int current_max;
 };
 
+struct qcom_battmgr_device_data {
+	const char *root_compatible;
+	const char *glink_compatible;
+	const struct power_supply_desc *battery_desc;
+};
+
 struct qcom_battmgr {
 	struct device *dev;
 	struct pmic_glink_client *client;
 
 	enum qcom_battmgr_variant variant;
+	const struct qcom_battmgr_device_data *device_data;
 
 	struct power_supply *ac_psy;
 	struct power_supply *bat_psy;
@@ -324,6 +350,7 @@
 	struct completion ack;
 
 	bool service_up;
+	bool shutting_down;
 
 	struct qcom_battmgr_info info;
 	struct qcom_battmgr_status status;
@@ -332,19 +359,135 @@
 	struct qcom_battmgr_wireless wireless;
 
 	struct work_struct enable_work;
+	struct work_struct kpfe_charge_work;
+	struct delayed_work kpfe_charge_rearm_work;
 
 	/*
 	 * @lock is used to prevent concurrent power supply requests to the
 	 * firmware, as it then stops responding.
 	 */
 	struct mutex lock;
+
+	enum power_supply_charge_behaviour kpfe_charge_behaviour;
+	bool kpfe_ack_tainted;
+	bool kpfe_request_active;
+	bool kpfe_draining;
+	u32 kpfe_expected_opcode;
+	u32 kpfe_expected_property;
+	bool kpfe_usb_online;
+	bool kpfe_usb_online_valid;
+	enum qcom_battmgr_kpfe_rearm_state kpfe_rearm_state;
+	bool kpfe_rearm_pulse_confirmed;
+	bool kpfe_rearm_prepare_after_reconcile;
+	unsigned long kpfe_rearm_not_before;
+	unsigned long kpfe_rearm_fast_deadline;
+	u32 kpfe_rearm_service_gen;
+	u32 kpfe_ready_service_gen;
+	atomic_t kpfe_service_gen;
 };
 
+static int qcom_battmgr_request_once(struct qcom_battmgr *battmgr, void *data,
+				     size_t len)
+{
+	const struct qcom_battmgr_property_request *request = data;
+	unsigned long left;
+	u32 service_gen = (u32)atomic_read(&battmgr->kpfe_service_gen);
+	int ret;
+
+	if (READ_ONCE(battmgr->shutting_down) || !READ_ONCE(battmgr->client))
+		return -ESHUTDOWN;
+	if (battmgr->device_data &&
+	    READ_ONCE(battmgr->kpfe_ack_tainted))
+		return -EUCLEAN;
+	if (!READ_ONCE(battmgr->service_up))
+		return -EAGAIN;
+
+	reinit_completion(&battmgr->ack);
+
+	battmgr->error = 0;
+	if (battmgr->device_data) {
+		battmgr->kpfe_expected_opcode = le32_to_cpu(request->hdr.opcode);
+		battmgr->kpfe_expected_property = U32_MAX;
+		if (battmgr->kpfe_expected_opcode == BATTMGR_BAT_PROPERTY_GET ||
+		    battmgr->kpfe_expected_opcode == BATTMGR_BAT_PROPERTY_SET ||
+		    battmgr->kpfe_expected_opcode == BATTMGR_USB_PROPERTY_GET ||
+		    battmgr->kpfe_expected_opcode == BATTMGR_WLS_PROPERTY_GET)
+			battmgr->kpfe_expected_property = le32_to_cpu(request->property);
+		/* Publish reply fields before the receive callback consumes them. */
+		smp_store_release(&battmgr->kpfe_request_active, true);
+	}
+
+	ret = pmic_glink_send(battmgr->client, data, len);
+	if (ret < 0)
+		goto out;
+
+	left = wait_for_completion_timeout(&battmgr->ack, HZ);
+	ret = left ? battmgr->error : -ETIMEDOUT;
+	if (!ret && battmgr->device_data &&
+	    (!READ_ONCE(battmgr->service_up) ||
+	     service_gen != (u32)atomic_read(&battmgr->kpfe_service_gen)))
+		ret = -EAGAIN;
+
+out:
+	if (battmgr->device_data)
+		WRITE_ONCE(battmgr->kpfe_request_active, false);
+	return ret;
+}
+
+static int qcom_battmgr_drain_ack(struct qcom_battmgr *battmgr,
+				  unsigned long timeout,
+				  unsigned int max_responses)
+{
+	unsigned long left;
+	unsigned int drained;
+
+	WRITE_ONCE(battmgr->kpfe_draining, true);
+	/*
+	 * Firmware responses carry no token. Restart a full quiet interval after
+	 * each expected late ACK instead of trusting the first completion.
+	 */
+	for (drained = 0; drained <= max_responses; drained++) {
+		reinit_completion(&battmgr->ack);
+		left = wait_for_completion_timeout(&battmgr->ack, timeout);
+		if (!left) {
+			WRITE_ONCE(battmgr->kpfe_draining, false);
+			return 0;
+		}
+	}
+
+	reinit_completion(&battmgr->ack);
+	WRITE_ONCE(battmgr->kpfe_ack_tainted, true);
+	WRITE_ONCE(battmgr->kpfe_draining, false);
+	return -EOVERFLOW;
+}
+
+static int qcom_battmgr_kpfe_request(struct qcom_battmgr *battmgr, void *data,
+				size_t len)
+{
+	int drain_ret;
+	int ret;
+
+	ret = qcom_battmgr_request_once(battmgr, data, len);
+	if (ret == -ETIMEDOUT && battmgr->device_data) {
+		drain_ret = qcom_battmgr_drain_ack(battmgr, HZ, 1);
+		if (drain_ret) {
+			dev_err_ratelimited(battmgr->dev,
+					    "too many late KPFE firmware responses\n");
+			return drain_ret;
+		}
+	}
+
+	return ret;
+}
+
 static int qcom_battmgr_request(struct qcom_battmgr *battmgr, void *data, size_t len)
 {
 	unsigned long left;
 	int ret;
 
+	if (battmgr->device_data)
+		return qcom_battmgr_kpfe_request(battmgr, data, len);
+
 	reinit_completion(&battmgr->ack);
 
 	battmgr->error = 0;
@@ -375,6 +518,22 @@
 	return qcom_battmgr_request(battmgr, &request, sizeof(request));
 }
 
+static int qcom_battmgr_request_property_once(struct qcom_battmgr *battmgr,
+					      int opcode, int property,
+					      u32 value)
+{
+	struct qcom_battmgr_property_request request = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(opcode),
+		.battery = cpu_to_le32(0),
+		.property = cpu_to_le32(property),
+		.value = cpu_to_le32(value),
+	};
+
+	return qcom_battmgr_request_once(battmgr, &request, sizeof(request));
+}
+
 static int qcom_battmgr_update_status(struct qcom_battmgr *battmgr)
 {
 	struct qcom_battmgr_update_request request = {
@@ -509,6 +668,43 @@
 	return ret;
 }
 
+static int qcom_battmgr_kpfe_bat_get_property(struct power_supply *psy,
+					    enum power_supply_property psp,
+					    union power_supply_propval *val)
+{
+	struct qcom_battmgr *battmgr = power_supply_get_drvdata(psy);
+	int ret;
+
+	if (psp == POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR) {
+		mutex_lock(&battmgr->lock);
+		val->intval = battmgr->kpfe_charge_behaviour;
+		mutex_unlock(&battmgr->lock);
+		return 0;
+	}
+
+	if (psp == POWER_SUPPLY_PROP_STATUS) {
+		ret = qcom_battmgr_bat_sm8350_update(battmgr, psp);
+		if (ret < 0)
+			return ret;
+	}
+
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET,
+					   BATT_ONLINE, 0);
+	if (!ret) {
+		if (psp == POWER_SUPPLY_PROP_ONLINE)
+			val->intval = battmgr->info.online;
+		else if (!battmgr->info.online &&
+			 battmgr->status.status == POWER_SUPPLY_STATUS_CHARGING)
+			val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		else
+			val->intval = battmgr->status.status;
+	}
+	mutex_unlock(&battmgr->lock);
+
+	return ret;
+}
+
 static int qcom_battmgr_bat_get_property(struct power_supply *psy,
 					 enum power_supply_property psp,
 					 union power_supply_propval *val)
@@ -520,6 +716,12 @@
 	if (!battmgr->service_up)
 		return -EAGAIN;
 
+	if (battmgr->device_data &&
+	    (psp == POWER_SUPPLY_PROP_ONLINE ||
+	     psp == POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR ||
+	     psp == POWER_SUPPLY_PROP_STATUS))
+		return qcom_battmgr_kpfe_bat_get_property(psy, psp, val);
+
 	if (battmgr->variant == QCOM_BATTMGR_SC8280XP ||
 	    battmgr->variant == QCOM_BATTMGR_X1E80100)
 		ret = qcom_battmgr_bat_sc8280xp_update(battmgr, psp);
@@ -674,6 +876,39 @@
 	return qcom_battmgr_request(battmgr, &request, sizeof(request));
 }
 
+static int qcom_battmgr_kpfe_set_charge_start_threshold(struct qcom_battmgr *battmgr, int start_soc)
+{
+	u32 target_soc, delta_soc;
+	int ret;
+
+	start_soc = clamp(start_soc, CHARGE_CTRL_START_THR_MIN, CHARGE_CTRL_START_THR_MAX);
+	mutex_lock(&battmgr->lock);
+
+	/*
+	 * If the new start threshold is larger than the old end threshold,
+	 * move the end threshold one step (DELTA_SOC) after the new start
+	 * threshold.
+	 */
+	if (start_soc > battmgr->info.charge_ctrl_end) {
+		target_soc = start_soc + CHARGE_CTRL_DELTA_SOC;
+		target_soc = min_t(u32, target_soc, CHARGE_CTRL_END_THR_MAX);
+		delta_soc = target_soc - start_soc;
+		delta_soc = min_t(u32, delta_soc, CHARGE_CTRL_DELTA_SOC);
+	} else {
+		target_soc =  battmgr->info.charge_ctrl_end;
+		delta_soc = battmgr->info.charge_ctrl_end - start_soc;
+	}
+
+	ret = qcom_battmgr_set_charge_control(battmgr, target_soc, delta_soc);
+	if (!ret) {
+		battmgr->info.charge_ctrl_start = start_soc;
+		battmgr->info.charge_ctrl_end = target_soc;
+	}
+	mutex_unlock(&battmgr->lock);
+
+	return ret;
+}
+
 static int qcom_battmgr_set_charge_start_threshold(struct qcom_battmgr *battmgr, int start_soc)
 {
 	u32 target_soc, delta_soc;
@@ -707,6 +942,27 @@
 	return 0;
 }
 
+static int qcom_battmgr_kpfe_set_charge_end_threshold(struct qcom_battmgr *battmgr, int end_soc)
+{
+	u32 delta_soc = CHARGE_CTRL_DELTA_SOC;
+	int ret;
+
+	end_soc = clamp(end_soc, CHARGE_CTRL_END_THR_MIN, CHARGE_CTRL_END_THR_MAX);
+	mutex_lock(&battmgr->lock);
+
+	if (battmgr->info.charge_ctrl_start && end_soc > battmgr->info.charge_ctrl_start)
+		delta_soc = end_soc - battmgr->info.charge_ctrl_start;
+
+	ret = qcom_battmgr_set_charge_control(battmgr, end_soc, delta_soc);
+	if (!ret) {
+		battmgr->info.charge_ctrl_start = end_soc - delta_soc;
+		battmgr->info.charge_ctrl_end = end_soc;
+	}
+	mutex_unlock(&battmgr->lock);
+
+	return ret;
+}
+
 static int qcom_battmgr_set_charge_end_threshold(struct qcom_battmgr *battmgr, int end_soc)
 {
 	u32 delta_soc = CHARGE_CTRL_DELTA_SOC;
@@ -760,7 +1016,11 @@
 static int qcom_battmgr_bat_is_writeable(struct power_supply *psy,
 					 enum power_supply_property psp)
 {
+	struct qcom_battmgr *battmgr = power_supply_get_drvdata(psy);
+
 	switch (psp) {
+	case POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR:
+		return !!battmgr->device_data;
 	case POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD:
 	case POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD:
 		return 1;
@@ -771,12 +1031,204 @@
 	return 0;
 }
 
+static int qcom_battmgr_kpfe_send_charging(struct qcom_battmgr *battmgr,
+					   bool allow_charging)
+{
+	struct qcom_battmgr_property_request request = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(BATTMGR_BAT_PROPERTY_SET),
+		.battery = cpu_to_le32(0),
+		.property = cpu_to_le32(BATT_ONLINE),
+		.value = cpu_to_le32(allow_charging),
+	};
+
+	if (!READ_ONCE(battmgr->client) ||
+	    (READ_ONCE(battmgr->shutting_down) && allow_charging))
+		return -ESHUTDOWN;
+
+	return pmic_glink_send(battmgr->client, &request, sizeof(request));
+}
+
+static int qcom_battmgr_kpfe_set_charging(struct qcom_battmgr *battmgr,
+					  bool allow_charging)
+{
+	int drain_ret;
+	int send_ret;
+	int ret;
+
+	ret = qcom_battmgr_request_property_once(battmgr,
+						 BATTMGR_BAT_PROPERTY_SET,
+						 BATT_ONLINE, allow_charging);
+	if (ret && ret != -ESHUTDOWN && ret != -EUCLEAN) {
+		/* The very next firmware send must neutralize any uncertain SET1. */
+		reinit_completion(&battmgr->ack);
+		battmgr->error = 0;
+		send_ret = qcom_battmgr_kpfe_send_charging(battmgr, false);
+		if (send_ret < 0)
+			send_ret = qcom_battmgr_kpfe_send_charging(battmgr, false);
+		drain_ret = qcom_battmgr_drain_ack(battmgr,
+						   msecs_to_jiffies(KPFE_BYPASS_ACK_DRAIN_MS),
+						   KPFE_BYPASS_ACK_DRAIN_MAX);
+		if (send_ret < 0)
+			dev_err_ratelimited(battmgr->dev,
+					    "failed to send emergency KPFE SET0: %d\n",
+					    send_ret);
+		if (send_ret < 0) {
+			WRITE_ONCE(battmgr->kpfe_ack_tainted, true);
+			ret = send_ret;
+		}
+		if (drain_ret)
+			dev_err_ratelimited(battmgr->dev,
+					    "KPFE SET response quarantine overflow\n");
+		if (drain_ret)
+			ret = drain_ret;
+	} else if (ret == -EUCLEAN || ret == -ESHUTDOWN) {
+		/* Teardown must still neutralize an in-flight SET1 before client release. */
+		send_ret = qcom_battmgr_kpfe_send_charging(battmgr, false);
+		if (send_ret < 0)
+			send_ret = qcom_battmgr_kpfe_send_charging(battmgr, false);
+		if (send_ret < 0)
+			dev_err_ratelimited(battmgr->dev,
+					    "failed to send fail-safe KPFE SET0: %d\n",
+					    send_ret);
+	}
+	if (!ret)
+		battmgr->info.online = allow_charging;
+
+	return ret;
+}
+
+static int qcom_battmgr_kpfe_quarantine_disable(struct qcom_battmgr *battmgr)
+{
+	int drain_ret;
+	int ret;
+
+	/*
+	 * The SET acknowledgment does not echo its value. Send SET0 without
+	 * waiting so an ambiguous SET1 is made fail-safe at once, then keep the
+	 * request mutex held while all usual late responses are quarantined.
+	 */
+	reinit_completion(&battmgr->ack);
+	battmgr->error = 0;
+	ret = qcom_battmgr_kpfe_send_charging(battmgr, false);
+	if (ret < 0)
+		ret = qcom_battmgr_kpfe_send_charging(battmgr, false);
+
+	drain_ret = qcom_battmgr_drain_ack(battmgr,
+					   msecs_to_jiffies(KPFE_BYPASS_ACK_DRAIN_MS),
+					   KPFE_BYPASS_ACK_DRAIN_MAX);
+	if (drain_ret)
+		return drain_ret;
+
+	/* This waited SET0 also drains its own timeout before the mutex opens. */
+	return qcom_battmgr_kpfe_set_charging(battmgr, false);
+}
+
+static int qcom_battmgr_kpfe_update_usb_online(struct qcom_battmgr *battmgr)
+{
+	return qcom_battmgr_request_property(battmgr,
+					     BATTMGR_USB_PROPERTY_GET,
+					     USB_ONLINE, 0);
+}
+
+static int qcom_battmgr_kpfe_update_usb_online_once(struct qcom_battmgr *battmgr)
+{
+	return qcom_battmgr_request_property_once(battmgr,
+						  BATTMGR_USB_PROPERTY_GET,
+						  USB_ONLINE, 0);
+}
+
+static bool qcom_battmgr_kpfe_service_current(struct qcom_battmgr *battmgr,
+					      u32 service_gen);
+static bool qcom_battmgr_kpfe_service_ready(struct qcom_battmgr *battmgr,
+					    u32 service_gen);
+
+static int qcom_battmgr_kpfe_bat_set_property(struct power_supply *psy,
+					 enum power_supply_property psp,
+					 const union power_supply_propval *pval)
+{
+	struct qcom_battmgr *battmgr = power_supply_get_drvdata(psy);
+	enum power_supply_charge_behaviour behaviour;
+	bool allow_charging;
+	bool preserve_rearm;
+	u32 service_gen;
+	int ret;
+
+	if (!battmgr->service_up)
+		return -EAGAIN;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR:
+		if (!battmgr->device_data)
+			return -EINVAL;
+
+		behaviour = pval->intval;
+		if (behaviour != POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO &&
+		    behaviour != POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE)
+			return -EINVAL;
+
+		mutex_lock(&battmgr->lock);
+		service_gen = (u32)atomic_read(&battmgr->kpfe_service_gen);
+		if (!qcom_battmgr_kpfe_service_ready(battmgr, service_gen)) {
+			ret = -EAGAIN;
+			goto out_unlock;
+		}
+		ret = qcom_battmgr_kpfe_update_usb_online(battmgr);
+		if (ret)
+			goto out_unlock;
+
+		allow_charging = !battmgr->usb.online ||
+			behaviour == POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO;
+		preserve_rearm = behaviour == POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE &&
+			battmgr->kpfe_charge_behaviour == behaviour &&
+			battmgr->kpfe_rearm_state != KPFE_REARM_IDLE &&
+			battmgr->kpfe_rearm_service_gen == service_gen;
+		ret = qcom_battmgr_kpfe_set_charging(battmgr, allow_charging);
