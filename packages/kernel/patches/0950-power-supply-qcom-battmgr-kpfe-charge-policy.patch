+static void qcom_battmgr_kpfe_pdr_notify(void *priv, int state)
+{
+	struct qcom_battmgr *battmgr = priv;
+
+	if (READ_ONCE(battmgr->shutting_down))
+		return;
+
+	if (state == SERVREG_SERVICE_STATE_UP) {
+		atomic_inc(&battmgr->kpfe_service_gen);
+		WRITE_ONCE(battmgr->service_up, true);
+		queue_work(system_percpu_wq, &battmgr->enable_work);
+	} else {
+		WRITE_ONCE(battmgr->service_up, false);
+		atomic_inc(&battmgr->kpfe_service_gen);
+		if (battmgr->device_data) {
+			cancel_delayed_work(&battmgr->kpfe_charge_rearm_work);
+			WRITE_ONCE(battmgr->kpfe_usb_online_valid, false);
+		}
+	}
+}
