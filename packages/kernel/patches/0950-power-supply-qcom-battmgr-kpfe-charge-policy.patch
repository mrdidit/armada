+static void qcom_battmgr_kpfe_callback(const void *data, size_t len, void *priv)
+{
+	const struct pmic_glink_hdr *hdr = data;
+	const struct qcom_battmgr_message *resp = data;
+	struct qcom_battmgr *battmgr = priv;
+	unsigned int opcode;
+	u32 property;
+	size_t payload_len;
+
+	if (READ_ONCE(battmgr->shutting_down) || len < sizeof(*hdr))
+		return;
+	opcode = le32_to_cpu(hdr->opcode);
+
+	if (battmgr->device_data && opcode != BATTMGR_NOTIFICATION) {
+		if (READ_ONCE(battmgr->kpfe_draining)) {
+			complete(&battmgr->ack);
+			return;
+		}
+		/* Pairs with request_once's publication of opcode and property. */
+		if (!smp_load_acquire(&battmgr->kpfe_request_active) ||
+		    opcode != battmgr->kpfe_expected_opcode)
+			return;
+		property = battmgr->kpfe_expected_property;
+		if (property != U32_MAX) {
+			payload_len = len - sizeof(*hdr);
+			if (payload_len < sizeof(__le32))
+				goto invalid_response;
+			if (le32_to_cpu(resp->intval.property) != property)
+				return;
+			if (opcode == BATTMGR_BAT_PROPERTY_GET &&
+			    property == BATT_MODEL_NAME) {
+				if (payload_len != sizeof(resp->strval))
+					goto invalid_response;
+			} else {
+				if (payload_len != sizeof(resp->intval))
+					goto invalid_response;
+				if (opcode != BATTMGR_BAT_PROPERTY_SET &&
+				    le32_to_cpu(resp->intval.result)) {
+					battmgr->error = -EIO;
+					complete(&battmgr->ack);
+					return;
+				}
+			}
+		}
+	}
+
+	if (opcode == BATTMGR_NOTIFICATION)
+		qcom_battmgr_notification(battmgr, data, len);
+	else if (qcom_battmgr_kpfe_property_response(battmgr, resp, len))
