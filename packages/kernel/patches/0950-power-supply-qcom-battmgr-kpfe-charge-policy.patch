+		return;
+
+	mutex_lock(&battmgr->lock);
+	if (!qcom_battmgr_kpfe_service_ready(battmgr, service_gen)) {
+		stale = true;
+		goto out_unlock;
+	}
+
+	if (battmgr->kpfe_rearm_state != KPFE_REARM_IDLE &&
+	    battmgr->kpfe_rearm_service_gen != service_gen)
