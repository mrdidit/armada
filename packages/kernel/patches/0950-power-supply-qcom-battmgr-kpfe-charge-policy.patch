+static void qcom_battmgr_kpfe_cancel_work(void *data)
+{
+	struct qcom_battmgr *battmgr = data;
+
+	WRITE_ONCE(battmgr->shutting_down, true);
+	WRITE_ONCE(battmgr->service_up, false);
+	atomic_inc(&battmgr->kpfe_service_gen);
+	disable_work_sync(&battmgr->enable_work);
+	disable_work_sync(&battmgr->kpfe_charge_work);
+	disable_delayed_work_sync(&battmgr->kpfe_charge_rearm_work);
+
+	/* Drain synchronous sysfs requests before devres releases the client. */
+	mutex_lock(&battmgr->lock);
+	WRITE_ONCE(battmgr->client, NULL);
+	mutex_unlock(&battmgr->lock);
+}
