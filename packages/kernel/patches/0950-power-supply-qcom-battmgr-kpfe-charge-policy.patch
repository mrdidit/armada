+static void qcom_battmgr_kpfe_enable_worker(struct work_struct *work)
+{
+	struct qcom_battmgr *battmgr = container_of(work, struct qcom_battmgr, enable_work);
+	struct qcom_battmgr_enable_request req = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_NOTIFY),
+		.hdr.opcode = cpu_to_le32(BATTMGR_REQUEST_NOTIFICATION),
+	};
+	bool queue_kpfe = false;
+	bool stale = false;
+	bool taint_recovery_failed = false;
+	u32 service_gen = 0;
+	int ret = 0;
+
+	if (battmgr->device_data) {
+		service_gen = (u32)atomic_read(&battmgr->kpfe_service_gen);
+		if (!qcom_battmgr_kpfe_service_current(battmgr, service_gen))
+			return;
+	}
+
+	mutex_lock(&battmgr->lock);
+	if (battmgr->device_data &&
+	    !qcom_battmgr_kpfe_service_current(battmgr, service_gen)) {
+		stale = true;
+		goto out_unlock;
+	}
+	if (battmgr->device_data &&
+	    READ_ONCE(battmgr->kpfe_ack_tainted)) {
+		/* Reassert fail-safe SET0 on the new service before reopening RPCs. */
+		reinit_completion(&battmgr->ack);
+		battmgr->error = 0;
+		ret = qcom_battmgr_kpfe_send_charging(battmgr, false);
+		if (ret < 0)
+			ret = qcom_battmgr_kpfe_send_charging(battmgr, false);
+		if (ret < 0) {
+			taint_recovery_failed = true;
+			goto out_unlock;
+		}
+		ret = qcom_battmgr_drain_ack(battmgr,
+					     msecs_to_jiffies(KPFE_BYPASS_ACK_DRAIN_MS),
+					     KPFE_BYPASS_ACK_DRAIN_MAX);
+		if (ret) {
+			taint_recovery_failed = true;
+			goto out_unlock;
+		}
+		if (!qcom_battmgr_kpfe_service_current(battmgr, service_gen)) {
+			stale = true;
+			goto out_unlock;
+		}
+		WRITE_ONCE(battmgr->kpfe_ack_tainted, false);
+		ret = qcom_battmgr_kpfe_set_charging(battmgr, false);
+		if (ret) {
+			WRITE_ONCE(battmgr->kpfe_ack_tainted, true);
+			taint_recovery_failed = true;
+			goto out_unlock;
+		}
+		if (!qcom_battmgr_kpfe_service_current(battmgr, service_gen)) {
+			WRITE_ONCE(battmgr->kpfe_ack_tainted, true);
+			stale = true;
+			goto out_unlock;
+		}
+	}
+	ret = qcom_battmgr_request(battmgr, &req, sizeof(req));
+	if (!ret && battmgr->device_data) {
+		if (!qcom_battmgr_kpfe_service_current(battmgr, service_gen)) {
+			stale = true;
+			goto out_unlock;
+		}
+
+		WRITE_ONCE(battmgr->kpfe_ready_service_gen, service_gen);
+		WRITE_ONCE(battmgr->kpfe_usb_online_valid, false);
+		qcom_battmgr_kpfe_clear_rearm_locked(battmgr);
+		cancel_delayed_work(&battmgr->kpfe_charge_rearm_work);
+		if (battmgr->kpfe_charge_behaviour ==
+		    POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE)
+			qcom_battmgr_kpfe_prepare_rearm_locked(battmgr,
+							       KPFE_BYPASS_REARM_DELAY_MS);
+		queue_kpfe = true;
+	}
+
+out_unlock:
+	mutex_unlock(&battmgr->lock);
+
+	if (taint_recovery_failed)
+		dev_err(battmgr->dev,
+			"failed to recover tainted KPFE charge transport: %d\n", ret);
+	else if (ret && !stale)
+		dev_err(battmgr->dev, "failed to request power notifications\n");
+	else if (queue_kpfe &&
+		 qcom_battmgr_kpfe_service_ready(battmgr, service_gen))
+		queue_work(system_percpu_wq, &battmgr->kpfe_charge_work);
+}
