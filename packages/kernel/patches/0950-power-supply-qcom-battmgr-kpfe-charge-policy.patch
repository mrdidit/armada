+static bool qcom_battmgr_kpfe_property_response(struct qcom_battmgr *battmgr,
+					      const struct qcom_battmgr_message *resp,
+					      size_t len)
+{
+	unsigned int opcode = le32_to_cpu(resp->hdr.opcode);
+	size_t payload_len = len - sizeof(resp->hdr);
+
+	if (opcode == BATTMGR_BAT_PROPERTY_SET) {
+		if (payload_len != sizeof(resp->intval) ||
+		    le32_to_cpu(resp->intval.property) != BATT_ONLINE)
+			battmgr->error = -ENODATA;
+		else
+			/* KPFE SET acknowledgements leave value and result undefined. */
+			battmgr->error = 0;
+	} else if (opcode == BATTMGR_BAT_PROPERTY_GET) {
+		if (payload_len < sizeof(__le32) ||
+		    le32_to_cpu(resp->intval.property) != BATT_ONLINE)
+			return false;
+		if (payload_len != sizeof(resp->intval))
+			battmgr->error = -ENODATA;
+		else if (le32_to_cpu(resp->intval.result))
+			battmgr->error = -EIO;
+		else {
+			battmgr->info.online = le32_to_cpu(resp->intval.value);
+			battmgr->error = 0;
+		}
+	} else {
+		return false;
+	}
+
+	complete(&battmgr->ack);
+	return true;
+}
