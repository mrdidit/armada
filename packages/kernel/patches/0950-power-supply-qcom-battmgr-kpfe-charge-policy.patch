+	}
+
+	/* A successful SET1 ACK is the only dwell; SET0 is always next. */
+	disable_ret = qcom_battmgr_kpfe_set_charging(battmgr, false);
+	if (!qcom_battmgr_kpfe_service_current(battmgr, service_gen)) {
+		WRITE_ONCE(battmgr->kpfe_usb_online_valid, false);
+		stale = true;
+		goto out_unlock;
+	}
+	if (disable_ret) {
+		disable_failed = true;
+		slow_retry = qcom_battmgr_kpfe_retry_rearm_locked(battmgr,
+								  false);
+		goto out_unlock;
+	}
+
+	battmgr->kpfe_rearm_state = KPFE_REARM_RECONCILE;
+	goto reconcile;
+
+disable_only:
+	/* Never put a USB GET in front of this fail-safe SET0 retry. */
+	disable_ret = qcom_battmgr_kpfe_set_charging(battmgr, false);
+	if (!qcom_battmgr_kpfe_service_current(battmgr, service_gen)) {
+		WRITE_ONCE(battmgr->kpfe_usb_online_valid, false);
+		stale = true;
+		goto out_unlock;
+	}
+	if (disable_ret) {
+		disable_failed = true;
+		slow_retry = qcom_battmgr_kpfe_retry_rearm_locked(battmgr,
+								  false);
+		goto out_unlock;
+	}
+
+	battmgr->kpfe_rearm_state = KPFE_REARM_RECONCILE;
+
+reconcile:
+	usb_ret = qcom_battmgr_kpfe_update_usb_online(battmgr);
+	if (!qcom_battmgr_kpfe_service_current(battmgr, service_gen)) {
+		WRITE_ONCE(battmgr->kpfe_usb_online_valid, false);
+		stale = true;
+		goto out_unlock;
+	}
+	if (usb_ret) {
+		WRITE_ONCE(battmgr->kpfe_usb_online_valid, false);
+		slow_retry = qcom_battmgr_kpfe_retry_rearm_locked(battmgr,
+								  true);
+		goto out_unlock;
+	}
+
+	if (battmgr->usb.online) {
+		battmgr->kpfe_usb_online = true;
+		WRITE_ONCE(battmgr->kpfe_usb_online_valid, true);
+		if (battmgr->kpfe_rearm_prepare_after_reconcile) {
+			qcom_battmgr_kpfe_start_rearm_locked(battmgr,
+							     KPFE_BYPASS_REARM_DELAY_MS);
+			notify = true;
+			goto out_unlock;
+		}
+		completed = battmgr->kpfe_rearm_pulse_confirmed;
+		qcom_battmgr_kpfe_clear_rearm_locked(battmgr);
+		cancel_delayed_work(&battmgr->kpfe_charge_rearm_work);
+		notify = true;
+		goto out_unlock;
+	}
+
+restore_offline:
+	/*
+	 * USB is authoritatively offline. Restore the normal offline SET1
+	 * latch, then verify that the cable did not reattach during the write.
+	 */
+	battmgr->kpfe_rearm_state = KPFE_REARM_DISABLE_ONLY;
+	battmgr->kpfe_rearm_pulse_confirmed = false;
+	battmgr->kpfe_rearm_prepare_after_reconcile = true;
+	allow_ret = qcom_battmgr_kpfe_set_charging(battmgr, true);
+	if (!qcom_battmgr_kpfe_service_current(battmgr, service_gen)) {
+		/* A SET1 may have applied, so make one old-generation SET0 attempt. */
+		qcom_battmgr_kpfe_set_charging(battmgr, false);
+		WRITE_ONCE(battmgr->kpfe_usb_online_valid, false);
+		stale = true;
+		goto out_unlock;
+	}
+	if (allow_ret) {
+		allow_failed = true;
+		disable_ret = qcom_battmgr_kpfe_set_charging(battmgr, false);
+		if (!qcom_battmgr_kpfe_service_current(battmgr, service_gen)) {
+			WRITE_ONCE(battmgr->kpfe_usb_online_valid, false);
+			stale = true;
+			goto out_unlock;
+		}
+		if (disable_ret)
+			disable_failed = true;
+		else
+			notify = true;
+		WRITE_ONCE(battmgr->kpfe_usb_online_valid, false);
+		slow_retry = qcom_battmgr_kpfe_retry_rearm_locked(battmgr,
+								  false);
+		goto out_unlock;
+	}
+
+	usb_ret = qcom_battmgr_kpfe_update_usb_online_once(battmgr);
+	if (!qcom_battmgr_kpfe_service_current(battmgr, service_gen)) {
+		/* A SET1 may be active; neutralize it before discarding the work. */
+		if (usb_ret)
+			qcom_battmgr_kpfe_quarantine_disable(battmgr);
+		else
+			qcom_battmgr_kpfe_set_charging(battmgr, false);
+		WRITE_ONCE(battmgr->kpfe_usb_online_valid, false);
+		stale = true;
+		goto out_unlock;
+	}
+	if (!usb_ret && !battmgr->usb.online) {
+		battmgr->kpfe_usb_online = false;
+		WRITE_ONCE(battmgr->kpfe_usb_online_valid, true);
+		qcom_battmgr_kpfe_clear_rearm_locked(battmgr);
+		cancel_delayed_work(&battmgr->kpfe_charge_rearm_work);
+		notify = true;
+		goto out_unlock;
+	}
+
+	/* Unknown or reattached: restore SET0 before doing anything else. */
+	if (usb_ret)
+		disable_ret = qcom_battmgr_kpfe_quarantine_disable(battmgr);
+	else
+		disable_ret = qcom_battmgr_kpfe_set_charging(battmgr, false);
+	if (!qcom_battmgr_kpfe_service_current(battmgr, service_gen)) {
+		WRITE_ONCE(battmgr->kpfe_usb_online_valid, false);
+		stale = true;
+		goto out_unlock;
+	}
+	if (usb_ret) {
+		if (disable_ret)
+			disable_failed = true;
+		else
+			notify = true;
+		WRITE_ONCE(battmgr->kpfe_usb_online_valid, false);
+		slow_retry = qcom_battmgr_kpfe_retry_rearm_locked(battmgr,
+								  false);
+		goto out_unlock;
+	}
+	if (disable_ret) {
+		disable_failed = true;
+		slow_retry = qcom_battmgr_kpfe_retry_rearm_locked(battmgr,
+								  false);
+		goto out_unlock;
+	}
+
+	battmgr->kpfe_usb_online = true;
+	WRITE_ONCE(battmgr->kpfe_usb_online_valid, true);
+	qcom_battmgr_kpfe_start_rearm_locked(battmgr,
+					     KPFE_BYPASS_REARM_DELAY_MS);
+	notify = true;
+
+out_unlock:
+	mutex_unlock(&battmgr->lock);
+
+	if (pulse_uncertain)
+		dev_warn_ratelimited(battmgr->dev,
+				     "KPFE inhibit re-arm SET1 failed or was not acknowledged: %d\n",
+				     pulse_ret);
+	if (disable_failed && slow_retry)
+		dev_err_ratelimited(battmgr->dev,
+				    "still unable to restore KPFE inhibited charging: %d\n",
+				    disable_ret);
+	else if (allow_failed && slow_retry)
+		dev_warn_ratelimited(battmgr->dev,
+				     "still unable to restore KPFE offline charging state: %d\n",
+				     allow_ret);
+	else if (usb_ret && slow_retry)
+		dev_warn_ratelimited(battmgr->dev,
+				     "still unable to verify KPFE USB state: %d\n",
+				     usb_ret);
+	if (completed)
+		dev_info(battmgr->dev,
+			 "re-armed KPFE inhibited charging after USB attach\n");
+
+	if (notify)
+		power_supply_changed(battmgr->bat_psy);
+
+	if (stale)
+		dev_dbg(battmgr->dev, "discarded stale KPFE charge re-arm work\n");
+}
