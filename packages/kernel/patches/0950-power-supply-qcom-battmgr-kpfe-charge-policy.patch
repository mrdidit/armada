+static void qcom_battmgr_kpfe_charge_worker(struct work_struct *work)
+{
+	struct qcom_battmgr *battmgr =
+		container_of(work, struct qcom_battmgr, kpfe_charge_work);
+	bool allow_charging;
+	bool known_attach;
+	bool notify = false;
+	bool pending_rearm;
+	bool stale = false;
+	bool usb_online;
+	bool was_offline;
+	bool was_valid;
