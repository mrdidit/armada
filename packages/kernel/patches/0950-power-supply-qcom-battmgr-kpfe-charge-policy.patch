+		}
+		goto out_unlock;
+	}
+	if (!qcom_battmgr_kpfe_service_current(battmgr, service_gen)) {
+		WRITE_ONCE(battmgr->kpfe_usb_online_valid, false);
+		stale = true;
+		goto out_unlock;
+	}
+
+	usb_online = battmgr->usb.online;
+	known_attach = was_offline && usb_online;
+
+	if (was_valid && battmgr->kpfe_usb_online == usb_online) {
+		/* Recheck a possibly stale offline read from an attach notification. */
+		if (!usb_online &&
+		    battmgr->kpfe_charge_behaviour ==
+			POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE &&
+		    !pending_rearm)
+			qcom_battmgr_kpfe_prepare_rearm_locked(battmgr,
+							       KPFE_BYPASS_RETRY_MS);
+		goto out_unlock;
+	}
+
+	allow_charging = !usb_online ||
+		battmgr->kpfe_charge_behaviour ==
+			POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO;
+	ret = qcom_battmgr_kpfe_set_charging(battmgr, allow_charging);
+	if (!qcom_battmgr_kpfe_service_current(battmgr, service_gen)) {
+		WRITE_ONCE(battmgr->kpfe_usb_online_valid, false);
+		stale = true;
+		goto out_unlock;
+	}
+
+	if (ret) {
+		WRITE_ONCE(battmgr->kpfe_usb_online_valid, false);
+		if (battmgr->kpfe_charge_behaviour ==
+		    POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE)
+			qcom_battmgr_kpfe_prepare_rearm_locked(battmgr,
+							       KPFE_BYPASS_RETRY_MS);
