From: mrdidit <26687854+mrdidit@users.noreply.github.com>
Subject: [PATCH] ASoC: wcd-clsh: preserve WCD939x ULP startup state

Both headphone callbacks force the shared startup settings before enabling
the reference-counted flyback and buck supplies. The second channel
reapplies those settings after the first-user supply sequence has restored
the playback values, but neither supply helper repeats that restoration.

For WCD939x ULP playback, perform force-IQ setup only when the buck supply
has no active users. Preserve both channels' supply reference accounting.
Other codecs and modes retain their existing sequence. This is an isolated
stereo-playback test; mixed headphone/earpiece routes remain unvalidated.

---
 sound/soc/codecs/wcd-clsh-v2.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/sound/soc/codecs/wcd-clsh-v2.c b/sound/soc/codecs/wcd-clsh-v2.c
--- a/sound/soc/codecs/wcd-clsh-v2.c
+++ b/sound/soc/codecs/wcd-clsh-v2.c
@@ -547,7 +547,9 @@ static void wcd_clsh_v3_state_hph_r(struct wcd_clsh_ctrl *ctrl, int req_state,
 	if (is_enable) {
 		wcd_clsh_v3_set_buck_regulator_mode(component, mode);
 		wcd_clsh_v3_set_flyback_mode(component, mode);
-		wcd_clsh_v3_force_iq_ctl(component, mode, true);
+		if (ctrl->codec_version != WCD939X ||
+		    mode != CLS_H_ULP || !ctrl->buck_users)
+			wcd_clsh_v3_force_iq_ctl(component, mode, true);
 		wcd_clsh_v3_flyback_ctrl(component, ctrl, mode, true);
 		wcd_clsh_v3_set_flyback_current(component, mode);
 		wcd_clsh_v3_set_buck_mode(component, mode);
@@ -637,7 +639,9 @@ static void wcd_clsh_v3_state_hph_l(struct wcd_clsh_ctrl *ctrl, int req_state,
 	if (is_enable) {
 		wcd_clsh_v3_set_buck_regulator_mode(component, mode);
 		wcd_clsh_v3_set_flyback_mode(component, mode);
-		wcd_clsh_v3_force_iq_ctl(component, mode, true);
+		if (ctrl->codec_version != WCD939X ||
+		    mode != CLS_H_ULP || !ctrl->buck_users)
+			wcd_clsh_v3_force_iq_ctl(component, mode, true);
 		wcd_clsh_v3_flyback_ctrl(component, ctrl, mode, true);
 		wcd_clsh_v3_set_flyback_current(component, mode);
 		wcd_clsh_v3_set_buck_mode(component, mode);
